rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can read the archive; only you can write.
    // Replace YOUR_UID with your Authentication user UID
    // (Firebase console > Authentication > Users).
    match /records/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "YOUR_UID";
    }
    match /meta/{doc} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "YOUR_UID";
    }
  }
}
